          <mxGeometry x="1200" y="55" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  SELF-HEALING LAYER                                      -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="aihandler" value="&lt;b&gt;ai_handler.py — _watch_ci_and_heal()&lt;/b&gt;&lt;br&gt;Background daemon thread • threading.Event cancel&lt;br&gt;threading.Lock on shared state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;fontColor=#ffffff;strokeColor=#4a148c;fontSize=12;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="60" y="45" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;1. Snapshot&lt;/b&gt;&lt;br&gt;Pre-populate seen_run_ids&lt;br&gt;with all pre-existing runs&lt;br&gt;(prevents picking stale runs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ab47bc;fontColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="60" y="145" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pollruns" value="&lt;b&gt;2. Poll Runs&lt;/b&gt;&lt;br&gt;GET /actions/runs?branch=...&lt;br&gt;require id &gt; max(seen_ids)&lt;br&gt;wait up to 25×12s = 5 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ab47bc;fontColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="270" y="145" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pollstatus" value="&lt;b&gt;3. Poll Status&lt;/b&gt;&lt;br&gt;GET /actions/runs/{id}&lt;br&gt;every 12s up to 90 ticks&lt;br&gt;wait for &#39;completed&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ab47bc;fontColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="480" y="145" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fetchlogs" value="&lt;b&gt;4. Fetch Logs&lt;/b&gt;&lt;br&gt;GET /runs/{id}/logs&lt;br&gt;302 → S3 presigned URL&lt;br&gt;extract error lines (8000 chars)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ab47bc;fontColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="690" y="145" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fixprompt" value="&lt;b&gt;5. Fix Prompt&lt;/b&gt;&lt;br&gt;_build_ci_fix_prompt()&lt;br&gt;current YAML + Dockerfile&lt;br&gt;+ error log + rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ab47bc;fontColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="900" y="145" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fixsanitize" value="&lt;b&gt;6. Sanitize Fix&lt;/b&gt;&lt;br&gt;_sanitize_expressions()&lt;br&gt;_sanitize_runner()&lt;br&gt;_ensure_trailing_newline()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ab47bc;fontColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="1110" y="145" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fixpush" value="&lt;b&gt;7. Commit &amp; Push Fix&lt;/b&gt;&lt;br&gt;fetch+rebase → commit&lt;br&gt;push → wait 15s&lt;br&gt;Retry up to 2 times" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ab47bc;fontColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;shadow=1;" vertex="1" parent="lane_watch">
          <mxGeometry x="1320" y="145" width="180" height="55" as="geometry" />
        </mxCell>
