          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_git2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="githandler" target="precommit" parent="lane_git">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_git3" value="push feature branch" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c62828;fontStyle=1;fontSize=11;" edge="1" source="precommit" target="remoterepo" parent="lane_git">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_git4" value="triggers" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c62828;fontStyle=1;fontSize=11;dashed=1;" edge="1" source="remoterepo" target="ghactions" parent="lane_git">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  EDGES — GIT → WATCH                                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="e_watch_start" value="thread start&lt;br&gt;(after push)" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.25;entryY=0;strokeColor=#6a1b9a;fontStyle=1;fontSize=11;" edge="1" parent="1" source="ghactions" target="aihandler">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  EDGES — WATCH STEPS                                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="e_w1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="aihandler" target="snapshot" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="snapshot" target="pollruns" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pollruns" target="pollstatus" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w4" value="success" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00c853;fontStyle=1;fontSize=11;" edge="1" source="pollstatus" target="pass_end" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w5" value="failure" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d50000;fontStyle=1;fontSize=11;" edge="1" source="pollstatus" target="fetchlogs" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="fetchlogs" target="fixprompt" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="fixprompt" target="fixsanitize" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="fixsanitize" target="fixpush" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w9" value="max retries exceeded" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d50000;dashed=1;fontStyle=2;fontSize=10;" edge="1" source="fixpush" target="fail_end" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_w10" value="retry (poll new run)" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;strokeColor=#6a1b9a;dashed=1;fontStyle=2;fontSize=10;" edge="1" source="fixpush" target="pollruns" parent="lane_watch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1410" y="215" />
              <mxPoint x="1410" y="240" />
              <mxPoint x="360" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_w11" value="cancel event set" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ff6d00;dashed=1;fontStyle=2;fontSize=10;" edge="1" source="pollstatus" target="cancelled" parent="lane_watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  EDGES — WATCH → AI (fix prompt calls LLM)               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="e_fix_llm" value="fix prompt" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#f57f17;fontStyle=1;fontSize=11;" edge="1" parent="1" source="fixprompt" target="groq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- LEGEND                                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="Core module (Python file)" style="rounded=1;fillColor=#388e3c;fontColor=#ffffff;strokeColor=#1b5e20;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="20" y="40" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="AI / LLM provider" style="rounded=1;fillColor=#f9a825;fontColor=#212121;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="220" y="40" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="Git / remote resource" style="rounded=1;fillColor=#c62828;fontColor=#ffffff;strokeColor=#7f0000;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="420" y="40" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="Background CI heal thread" style="rounded=1;fillColor=#6a1b9a;fontColor=#ffffff;strokeColor=#4a148c;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="20" y="90" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg5" value="Data artefact (YAML/dict)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="legend">
          <mxGeometry x="220" y="90" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg6" value="Optional / conditional flow" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="legend">
          <mxGeometry x="420" y="105" width="160" height="10" as="geometry">
            <mxPoint as="sourcePoint" x="420" y="105" />
            <mxPoint as="targetPoint" x="580" y="105" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
