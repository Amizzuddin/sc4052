{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "presentation": {
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
    },
    "problemMatcher": [],
    "tasks": [
        {
            "label": "Execute Python File",
            "type": "process",
            "command": "python3",
            "args": [
                "${input:selectPythonFile}"
            ],
        }
    ],
    "inputs": [
        {
            "id": "selectPythonFile",
            "type": "pickString",
            "description": "Select a Python file to run",
            "options": [
                {
                    "label": "Assignment 1",
                    "value": "workspace/assignments/one/main.py"
                },
                {
                    "label": "Assignment 2",
                    "value": "workspace/assignments/two/app.py"
                },
                {
                    "label": "Project",
                    "value": "workspace/project/api.py"
                }
            ]
        }
    ]
}
