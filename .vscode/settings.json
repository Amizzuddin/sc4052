{
    "files.associations": {
        "*compose.yml": "dockercompose"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.rulers": [120]
    },
    "black-formatter.args": [
        "--line-length", "120"
    ],
    "flake8.args": [
        "--line-length", "120"
    ]
}